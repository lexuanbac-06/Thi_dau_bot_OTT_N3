# Sao chép thành data/.env (file này KHÔNG được commit) rồi điền giá trị.

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# service_role: chỉ để trên máy chủ/máy chấm. Tuyệt đối không đưa vào trình duyệt/GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# Thí sinh đăng nhập bằng username; email giả = <username>@<domain> (không gửi mail thật)
OTT_EMAIL_DOMAIN=players.ott.example
OTT_OPEN_REGISTRATION=1
OTT_MIN_PASSWORD_LEN=8

# Tự đồng bộ ott.db -> Supabase sau entry-close / close / grade
OTT_SUPABASE_SYNC=1

# File nặng (replay) lưu ở máy local
OTT_STORAGE_DIR=./data/storage
OTT_STORAGE_PORT=8100
# Domain web của thí sinh được gọi storage server (CORS), cách nhau bởi dấu phẩy
OTT_CORS_ORIGINS=https://ott.example.com
